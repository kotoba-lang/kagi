(ns kagi.native-key
  "Non-exportable signing handles backed by a configured JCA KeyStore/HSM.

  This module never calls PrivateKey.getEncoded. The token/provider owns private
  material; kagi persists aliases and public encodings only."
  (:require [cbor.core :as cbor]
            [kagi.crypto :as crypto]))

;; (import block removed with the kbb/JS face: this module fails closed there.)

(defrecord HybridSigningHandle [keystore-id ed-alias mldsa-alias])
(defrecord HybridKemHandle [keystore-id x25519-alias mlkem-alias])

(declare sign require-native-keystore! sign-with key!)

(defrecord NativeSigner [keystore handle]
  crypto/SigningHandle
  (sign-hybrid [_ _provider message]
    (sign handle message)))

(defrecord NativeKemRecipient [keystore handle]
  crypto/DecapsulationHandle
  (decapsulate-hybrid [_ _provider ciphertext]
    (key handle ciphertext)))

;; ───────── kbb/JS face (2026-09-13): the JVM JCA KeyStore/HSM path is a
;; compatibility surface. On the JS face there is no OS keystore binding, so
;; every entry point fails CLOSED with a named error instead of silently
;; degrading: a caller that reaches for a native signing handle on kbb asked
;; for non-exportable material that this runtime cannot hold.
(defn- refuse [what]
  (throw (ex-info "kagi.native-key: no native keystore on the JS face"
                  {:native-key/refusal what})))

(defn require-native-keystore! [] (refuse :keystore-unavailable))
(defn sign [handle message] (refuse :sign-unavailable))
(defn key! [handle ciphertext] (refuse :decapsulate-unavailable))
(defn sign-with [handle provider message] (refuse :sign-unavailable))

(defn bound-signer
  "native-signing 設定が在れば signer を返す。JS face では設定が在っても
  keystore 装置が無いので always throw (fail closed)。"
  [_keystore-path {:keys [ed-alias mldsa-alias]}]
  (refuse (str "keystore binding unavailable: " ed-alias "/" mldsa-alias)))

(defn bound-kem-recipient
  [_keystore-path {:keys [x25519-alias mlkem-alias]}]
  (refuse (str "keystore binding unavailable: " x25519-alias "/" mlkem-alias)))

(defn key-metadata [m] m)
(defn sign-key? [m] false)
(defn native-signing-present? [] false)
