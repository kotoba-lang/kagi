(ns kagi.persist
  "vault スナップショットの edn 永続化。byte[] は base64 にして edn 安全にする。
  保存されるのは **暗号文 + wrap 済み鍵 + 台帳メタ** のみ(平文・素の VMK は出ない)。

  JVM-free kbb port (owner direction 2026-09-13: kbb/amu native route, no JVM
  fallback). The JVM original used FileChannel.lock + fsync + ATOMIC_MOVE; on
  the Node face this maps to:
  - lock: a best-effort advisory marker is NOT a lock — a single-writer
    invariant per process is kept with a per-path in-process atom; the
    cross-process FileChannel.lock is not reproducible on node:fs without
    O_EXCL create semantics, so save! takes an in-process lock and the
    .lock FILE is created O_EXCL-style via mkdir (mkdir is atomic on POSIX
    when the dir exists) for a coarse cross-process guard. Best-effort is
    stated honestly: two writers racing across machines is still resolved
    by last-writer-wins, as before on a non-NFS local FS.
  - fsync: node:fsyncSync on the file fd (mandatory durability) + best-effort
    directory fd fsync, same shape as the original.
  - ATOMIC_MOVE: fs.renameSync is atomic within one filesystem on POSIX —
    that is the replacement, with the non-atomic fallback removed (rename
    either works or throws).
  - PosixFilePermissions rw------- on the temp file: chmod 0600 before write.
  - Base64/UUID/Instant imports are gone: kagi.b64 (dual-runtime), js/crypto.
  All bytes flow through kagi.b64 so EDN stays text-safe on both runtimes."
  (:require [clojure.walk :as walk]
            [clojure.edn :as edn]
            [kagi.b64 :as b64]
            [scripts.nbb-compat :as compat]))

(def fs (js/require "node:fs"))
(def node-path (js/require "node:path"))

(defonce ^:private path-locks (atom {}))

(defn- path-lock [path]
  (let [key (str path)]
    (or (get @path-locks key)
        (get (swap! path-locks #(if (contains? % key) % (assoc % key (js-obj)))) key))))

(defn- enc [x]
  ;; bytes? is JVM-only; on the JS face a byte container is a typed array
  (if (instance? js/Uint8Array x) {:kagi/b64 (b64/encode x)} x))

(defn- dec* [x]
  (if (and (map? x) (contains? x :kagi/b64))
    (b64/decode (:kagi/b64 x))
    x))

(defn ->edn [data]
  (binding [*print-namespace-maps* false]
    (pr-str (walk/postwalk enc data))))
(defn <-edn [s] (walk/postwalk dec* (edn/read-string s)))

(defn save! [path data]
  (let [target (.resolve node-path (.cwd js/process) (str path))
        parent (.dirname node-path target)
        tmp (str target ".tmp")]
    (.mkdirSync fs parent #js {:recursive true})
    (locking (path-lock target)
      ;; coarse cross-process guard: an O_EXCL-style mkdir cannot race
      (let [lock-dir (str target ".lock")]
        (try (.mkdirSync fs lock-dir)
             (catch :default _ (throw (ex-info "kagi.persist: vault is locked by another writer" {:path (str path)}))))
        (try
          ;; write temp, fsync, rename (atomic within one filesystem), fsync dir
          (.writeFileSync fs tmp (->edn data) #js {:encoding "utf8" :flag "w" :mode 384})
          (let [fd (.openSync fs tmp "r+")]
            (try (.fsyncSync fs fd)
                 (finally (.closeSync fs fd))))
          (.renameSync fs tmp target)
          (try
            (let [dfd (.openSync fs parent "r")]
              (try (.fsyncSync fs dfd)
                   (finally (.closeSync fs dfd))))
            (catch :default _))
          (finally
            (try (.rmdirSync fs lock-dir) (catch :default _))
            (try (.unlinkSync fs tmp) (catch :default _))))))
    data))

(defn load* [path]
  (let [f (.resolve node-path (.cwd js/process) (str path))]
    (when (.existsSync fs f) (<-edn (.readFileSync fs f "utf8")))))
