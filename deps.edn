{:paths ["src" "web"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep, all
 ;; .cljc → portable to JVM / SCI / ClojureScript / GraalVM). The PQC primitives
 ;; (ML-KEM-768 / ML-DSA-65 / SLH-DSA) are provided on the JVM by BouncyCastle via
 ;; JCA; Ed25519 + AES-256-GCM come from the JDK.
 ;;
 ;; The browser side is `src/kagi/crypto/noble.cljs` — pure-JS `@noble/*`, declared
 ;; in package.json, NOT a Rust/WASM provider (this comment used to point at
 ;; kotoba-crypto Rust; no such provider was ever wired, and repo-wide policy
 ;; forbids adding new Rust). JVM consumers pulling this repo via :local/root or
 ;; :git/sha never resolve those npm packages.
 :deps {io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        ;; 1Password 互換 keychain データモデル + 1PUX import(crypto/store 非依存、
        ;; ADR-2607023000)。kagi は kagitaba item を pr-str して DEK 封緘パイプラインに通す。
        io.github.kotoba-lang/kagitaba
        {:git/url "https://github.com/kotoba-lang/kagitaba.git"
         :git/sha "91a96218b48757ca988d8467824e766317f2ca11"}
        ;; Shared fail-closed ABAC/control semantics. kagi owns only the
        ;; vault-specific attribute adapter and enforcement point.
        io.github.kotoba-lang/security
        {:git/url "https://github.com/kotoba-lang/security.git"
         :git/sha "49fc4ce359752e9fe6e547e9071b5b9b40da937a"}
        ;; Canonical receipt bytes for signed incident-response evidence.
        io.github.kotoba-lang/dag-cbor
        {:git/url "https://github.com/kotoba-lang/dag-cbor.git"
         :git/sha "578a48aeca110497298d22ce6d8b322dc14fe170"}
        ;; canonical did:key + IPNS-name derivation (ADR-2607050100) — replaces
        ;; this repo's own copy-pasted base58btc/base36/did-key/ipns-name.
        io.github.kotoba-lang/org-ietf-ed25519
        {:sha "fdcefb9f1b83461fee54d04b63e374fa301ee847"}
        io.github.kotoba-lang/tech-ipfs-specs-ipns
        {:sha "f2563eb1cb010c96f6dec1dfbd468fac93367498"}
        ;; The CACAO mint/verify this repo used to carry its own copy of.
        ;; ADR-2607268000: ~25 repos held that copy with a "keep in sync"
        ;; comment and diverged anyway; kagi's drifted far enough that
        ;; push/pull were dead against the live apex. The apex-shape rules now
        ;; live in `cacao.core/mint-kotobase-apex`, which THROWS on a
        ;; violation instead of returning a token the apex silently refuses.
        io.github.kotoba-lang/org-chainagnostic-cacao
        {:git/url "https://github.com/kotoba-lang/org-chainagnostic-cacao.git"
         :git/sha "9e65581af2e7d9869ceac13d2e1c508def4f9e45"}
        ;; Real memory-hard Argon2id. Deliberately a direct dependency: VMK
        ;; protection must never silently fall back to a cheap compatibility KDF.
        org.bouncycastle/bcprov-jdk18on {:mvn/version "1.84"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain-clj to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../langchain"}}}
  ;; clojure -M:dev:run  → drive the demo ops through one VaultActor
  :run {:main-opts ["-m" "kagi.sim"]}
  ;; clojure -M:dev:cli <cmd>  → op 相当の CLI(vault は ./.kagi)。bin/kagi も参照。
  :cli {:main-opts ["-m" "kagi.cli"]}
  :witness {:main-opts ["-m" "kagi.witness-main"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ;; TEST-ONLY. kagi's own runtime does not depend on
                      ;; io-storj: `store/object-sealed-block-store` takes the
                      ;; four functions, not a Storj client, so whoever wires
                      ;; the two depends on both (which is what storj.store's
                      ;; own docstring says the arrangement should be). This is
                      ;; here so the wiring is *proved* rather than described —
                      ;; storj.store contracts bytes as 0-255 vectors while
                      ;; kagi's AEAD wants byte[], and a fake-only test would
                      ;; not catch that mismatch.
                      io.github.kotoba-lang/io-storj
                      {:git/sha "daa038ba72fd515452d0f4091298568755a39ec9"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clojure -M:gen-vectors → JVM provider で cross-runtime 相互運用ベクタを再生成し
  ;; test/fixtures/jvm-crypto-vectors.edn へ書く(kagi.crypto.noble のテストが読む)。
  :gen-vectors {:extra-paths ["test"]
                :main-opts ["-m" "kagi.crypto.gen-interop-vectors"]}
  ;; static analysis — clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}
  :kotoba {:replace-deps {io.github.kotoba-lang/amu
                          {:git/url "https://github.com/kotoba-lang/amu.git"
                           :git/sha "b3a29de4d0e525e6bacd4b66dafc755a2f68536e"}}
           :main-opts ["-m" "kotoba.compiler.cli"]}}}
