{:paths ["src" "web" "test"]
 ;; kbb engine config (origin-owned name; see skill kbb-config-and-classpath).
 ;; kbb resolves NO Maven/git coordinates from deps.edn — every coordinate the
 ;; engine needs must be declared HERE, byte-for-byte copied from deps.edn /
 ;; the superproject manifest (west.yml), never guessed.
 ;;
 ;; NOTE 2026-09-13 (agent/kagi-native-ceiling): first step of the kagi
 ;; native-ceiling work — makes the pure test paths (noble-interop-test,
 ;; digest-noble-test) and the CLI entry resolvable on the kbb engine, no JVM.
 ;; org.bouncycastle (Argon2id JCA) and io.github.kotoba-lang/wallet etc. are
 ;; deliberately absent: the kbb route runs the noble provider
 ;; (kagi.crypto.noble), not jvm-provider.
 :deps {io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/text.git"
         :git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
        io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}
        io.github.kotoba-lang/kagitaba
        {:git/url "https://github.com/kotoba-lang/kagitaba.git"
         :git/sha "91a96218b48757ca988d8467824e766317f2ca11"}
        io.github.kotoba-lang/json
        {:git/url "https://github.com/kotoba-lang/json.git"
         :git/sha "15fd195ac41e6268e2005ccbf6cb9924e81e65e2"}}}
