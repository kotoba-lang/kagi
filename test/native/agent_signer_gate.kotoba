;; Whole native signer core gate. All keys are RFC 8032 PUBLIC test keys.
(ns kagi.agent-signer-gate (:export [main]))
(defn cg-report [name :string ok :bool] :i64
  (let [out (typed-cap-call 37 :string :string (str (if ok "PASS " "FAIL ") name "\n"))] (if ok 1 0)))
(defn cg-genesis-problem [pin :string signatures :string proof :string] :string
  (kg-keyset-problem "" pin (kg-v "genesis") signatures proof))
(defn cg-permit [state :string policy :string permit :string signature :string now :i64 sequence :i64 fence :i64 parent :string] :string
  (kg-permit-problem state policy permit signature now sequence fence parent))
(defn cg-chain [] :bool
  (let [pin (kg-v "pin")
        a (kg-apply "" pin (kg-v "genesis") (kg-v "genesis-signatures") (kg-v "genesis-proof"))
        b (kg-apply a pin (kg-v "rotation") (kg-v "rotation-signatures") (kg-v "rotation-proof"))
        c (kg-apply b pin (kg-v "revocation") (kg-v "revocation-signatures") (kg-v "revocation-proof"))
        d (kg-apply c pin (kg-v "recovery") (kg-v "recovery-signatures") (kg-v "recovery-proof"))
        e (kg-apply a pin (kg-v "govern") (kg-v "govern-signatures") (kg-v "govern-proof"))]
    (and (= a (kg-v "genesis-state")) (= b (kg-v "rotation-state")) (= c (kg-v "revocation-state"))
         (= d (kg-v "recovery-state")) (= e (kg-v "govern-state")))))
(defn cg-base [] :i64
  (+ (cg-report "full keyset chain: genesis rotate revoke recover govern" (arena-scope (cg-chain))) (+ (cg-report "genesis requires independently pinned digest" (arena-scope (= (cg-genesis-problem (kg-v "other-pin") (kg-v "genesis-signatures") (kg-v "genesis-proof")) "keyset/genesis-pin"))) (+ (cg-report "one of three cannot satisfy two-of-three" (arena-scope (= (cg-genesis-problem (kg-v "pin") (kg-v "one-signature") (kg-v "genesis-proof")) "keyset/management-signature"))) (+ (cg-report "zero management signatures refused" (arena-scope (= (cg-genesis-problem (kg-v "pin") (kg-zero 384) (kg-v "genesis-proof")) "keyset/management-signature"))) (+ (cg-report "author possession proof required" (arena-scope (= (cg-genesis-problem (kg-v "pin") (kg-v "genesis-signatures") (kg-zero 128)) "keyset/author-possession"))) (+ (cg-report "duplicate guardian keys refused" (arena-scope (not (kg-guards? (str (kg-v "public-0") (kg-v "public-0") (kg-v "public-2")) 2)))) (+ (cg-report "threshold above configured key count refused" (arena-scope (not (kg-guards? (str (kg-v "public-0") (kg-zero 128)) 2)))) (+ (cg-report "management signature cannot be reused as author proof" (arena-scope (= (cg-genesis-problem (kg-v "pin") (kg-v "genesis-signatures") (string-substring (kg-v "genesis-signatures") 0 128)) "keyset/author-possession"))) (+ (cg-report "foreign keyset transition refused" (arena-scope (= (kg-keyset-problem (kg-v "genesis-state") (kg-v "other-pin") (kg-v "rotation") (kg-v "rotation-signatures") (kg-v "rotation-proof")) "keyset/foreign-keyset"))) (+ (cg-report "old transition cannot be replayed on a newer head" (arena-scope (= (kg-keyset-problem (kg-v "rotation-state") (kg-v "pin") (kg-v "rotation") (kg-v "rotation-signatures") (kg-v "rotation-proof")) "keyset/parent-or-epoch"))) (+ (cg-report "new management threshold is applied" (arena-scope (= (kg-keyset-problem (kg-v "govern-state") (kg-v "pin") (kg-event "rotate" 2 (kg-hash (kg-v "govern")) (kg-v "public-0") (kg-hash (kg-v "policy2")) (kg-v "guards") 3) (kg-zero 384) (kg-zero 128)) "keyset/management-signature"))) (+ (cg-report "valid delegated operation verifies" (arena-scope (= (cg-permit (kg-v "genesis-state") (kg-v "policy") (kg-v "permit") (kg-v "permit-signature") 2000 0 7 (kg-v "zero")) ""))) (+ (cg-report "revoked author cannot sign" (arena-scope (= (cg-permit (kg-v "revocation-state") (kg-v "policy") (kg-v "permit") (kg-v "permit-signature") 2000 0 7 (kg-v "zero")) "signer/revoked"))) (+ (cg-report "old key epoch cannot sign after rotation" (arena-scope (= (cg-permit (kg-v "rotation-state") (kg-v "policy") (kg-v "permit") (kg-v "permit-signature") 2000 0 7 (kg-v "zero")) "signer/keyset-head-epoch"))) (+ (cg-report "wrong delegate signature refused" (arena-scope (= (cg-permit (kg-v "genesis-state") (kg-v "policy") (kg-v "permit") (kg-v "bad-delegate-signature") 2000 0 7 (kg-v "zero")) "signer/delegate-signature"))) (+ (cg-report "replay sequence refused" (arena-scope (= (cg-permit (kg-v "genesis-state") (kg-v "policy") (kg-v "permit") (kg-v "permit-signature") 2000 1 7 (kg-v "zero")) "signer/replay-or-sequence"))) (+ (cg-report "writer fence mismatch refused" (arena-scope (= (cg-permit (kg-v "genesis-state") (kg-v "policy") (kg-v "permit") (kg-v "permit-signature") 2000 0 8 (kg-v "zero")) "signer/writer-fence-parent"))) (+ (cg-report "parent head mismatch refused" (arena-scope (= (cg-permit (kg-v "genesis-state") (kg-v "policy") (kg-v "permit") (kg-v "permit-signature") 2000 0 7 (kg-v "other-pin")) "signer/writer-fence-parent"))) (+ (cg-report "expired operation refused" (arena-scope (= (cg-permit (kg-v "genesis-state") (kg-v "policy") (kg-v "permit") (kg-v "permit-signature") 30001 0 7 (kg-v "zero")) "signer/deadline"))) (+ (cg-report "not-yet-valid operation refused" (arena-scope (= (cg-permit (kg-v "genesis-state") (kg-v "policy") (kg-v "permit") (kg-v "permit-signature") 999 0 7 (kg-v "zero")) "signer/deadline"))) (+ (cg-report "changed policy refused" (arena-scope (= (cg-permit (kg-v "genesis-state") (kg-v "policy2") (kg-v "permit") (kg-v "permit-signature") 2000 0 7 (kg-v "zero")) "signer/policy-pin"))) (+ (cg-report "node key policy cannot authorize an agent operation" (arena-scope (= (kg-policy-problem (str "kagi.agent.policy.v1 node mon:fixture-a hata:fixture-a " (kg-v "public-1") " state-commit 30000")) "signer/role-purpose"))) (+ (cg-report "agent key policy cannot authorize node declaration" (arena-scope (= (kg-policy-problem (str "kagi.agent.policy.v1 agent mon:fixture-a hata:fixture-a " (kg-v "public-1") " node-declaration 30000")) "signer/role-purpose"))) (+ (cg-report "canonical number overflow refused" (arena-scope (= (kg-number "1000000000000000") -1))) (+ (cg-report "canonical number leading zero refused" (arena-scope (= (kg-number "01") -1))) (+ (cg-report "trailing newline and duplicate spaces refused" (arena-scope (and (not (kg-line? (string-concat (kg-v "permit") "\n") 13)) (not (kg-line? "a  b" 2))))) (+ (cg-report "native signature matches independent OpenSSL oracle" (arena-scope (= (kg-sign (hex-bytes (kg-v "seed-author")) (kg-v "genesis-state") (kg-v "policy") (kg-v "permit") (kg-v "permit-signature") 2000 0 7 (kg-v "zero")) (kg-v "action-signature")))) (+ (cg-report "another agent seed cannot sign this Cell author operation" (arena-scope (= (kg-sign (hex-bytes (kg-v "seed-other")) (kg-v "genesis-state") (kg-v "policy") (kg-v "permit") (kg-v "permit-signature") 2000 0 7 (kg-v "zero")) ""))) 0)))))))))))))))))))))))))))))

(defn main [] :i64
  (let [node (str "kagi.agent.policy.v1 node node:local tsukasa:local " (kg-v "public-1") " node-statements 60000")
        agent (str "kagi.agent.policy.v1 agent mon:local hata:local " (kg-v "public-1") " cell-writes 60000")]
    (+ (cg-base)
       (+ (cg-report "bounded node declaration and heartbeat purposes" (and (= (kg-policy-problem node) "") (kg-purpose-allowed? node "node-declaration") (kg-purpose-allowed? node "node-heartbeat")))
       (+ (cg-report "bounded agent action and commit purposes" (and (= (kg-policy-problem agent) "") (kg-purpose-allowed? agent "cell-action") (kg-purpose-allowed? agent "state-commit")))
       (+ (cg-report "purpose groups cannot cross node and agent roles" (and (not (kg-purpose-allowed? node "cell-action")) (not (kg-purpose-allowed? agent "node-heartbeat"))))
          (cg-report "group labels are never action purposes" (and (not (kg-purpose-allowed? node "node-statements")) (not (kg-purpose-allowed? agent "cell-writes"))))))))))
